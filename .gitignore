# Project-specific
# =========================
tmp
.claude

# Agent tooling / local scratch — NOT part of the deployable template
.omc/
agents/--first-contact/
standalone/

# Agent run outputs — ignore run artifacts/logs/assets, but KEEP the golden test fixtures
agents/figma_extractor/runs/*
!agents/figma_extractor/runs/run_sequential_003.json
agents/token_normalizer/runs/*
!agents/token_normalizer/runs/.golden.json

# spikes/ exploration archive: keep the source, ignore caches/logs
spikes/**/__pycache__/
spikes/**/*.log

