# ─────────────────────────────────────────────────────────────────────────────
# helix-agents — local dev .env TEMPLATE
#
#   cp .env.example .env   then fill the placeholders below.
#   .env is gitignored — NEVER commit real keys. This template holds placeholders only.
#   Full reference: docs/ENV.md. Setup walk-through: docs/SETUP.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
RUNTIME_ENV=dev            # dev = hot-reload + NO auth (local). prd = JWT auth on.
AGNO_DEBUG=true            # true = log every tool call. Handy locally.

# ── Models (LiteLLM proxy) ───────────────────────────────────────────────────
# The app speaks the plain OpenAI API and points at whatever OPENAI_BASE_URL says —
# set it to your LiteLLM proxy URL + token.
OPENAI_BASE_URL=https://litellm.services.plygrnd.tech
OPENAI_API_KEY=<your-litellm-proxy-key>
OPENAI_MODEL_ID=gpt-5.4                            # default chat model id on the proxy
FIGMA_PARSER_MODEL_ID=gpt-5.4                       # model id for the Figma-parsing lane (optional)
# Keep the `openai/` prefix on the embedder when going through LiteLLM — a bare id 401s.
OPENAI_EMBEDDER_ID=openai/text-embedding-3-small

# ── Database (Postgres + pgvector) ───────────────────────────────────────────
# Defaults match docs/SETUP.md (bare-metal OR the docker-compose.dev.yml one-liner).
DB_HOST=localhost
DB_PORT=5432
DB_USER=ai
DB_PASS=ai
DB_DATABASE=ai
DB_DRIVER=postgresql+psycopg

# ── Scheduler ────────────────────────────────────────────────────────────────
AGENTOS_URL=http://127.0.0.1:8000    # local scheduler base URL (public domain in prod)

# ── Figma (only if you run the Figma-extraction workflows) ───────────────────
# Personal Access Token from figma.com → Settings → Personal access tokens.
FIGMA_PAT=<your-figma-personal-access-token>

# ── Optional ─────────────────────────────────────────────────────────────────
# PARALLEL_API_KEY=<parallel-key>          # raises the web-search rate ceiling
# SLACK_BOT_TOKEN=<slack-bot-token>        # both Slack vars set → Slack interface loads
# SLACK_SIGNING_SECRET=<slack-signing-secret>
